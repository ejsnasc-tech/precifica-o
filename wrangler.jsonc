{
  "name": "precificacao-pro",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets"
  },
  "routes": [
    { "pattern": "topprecificacao.com.br", "custom_domain": true },
    { "pattern": "www.topprecificacao.com.br", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "precificacao-pro-db",
      "database_id": "6855c33b-7e18-458b-a501-510d3722147f"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "bebba38d0a7f489aa85e1c4a563dae20"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://topprecificacao.com.br"
  }
}
