{
  "name": "precificacao-pro",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".open-next/assets",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "precificacao-pro-db",
      "database_id": "COLE_O_ID_DO_D1_AQUI"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "COLE_O_ID_DO_KV_AQUI"
    }
  ]
}
