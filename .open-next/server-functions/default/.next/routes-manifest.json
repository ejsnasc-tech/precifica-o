  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/cadastro",
      "regex": "^/cadastro(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cadastro(?:/)?$"
    },
    {
      "page": "/dashboard",
