{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/catalogo-ingredientes/[id]",
      "regex": "^/api/catalogo\\-ingredientes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/catalogo\\-ingredientes/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/configuracoes/[empresaId]",
      "regex": "^/api/configuracoes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPempresaId": "nxtPempresaId"
      },
      "namedRegex": "^/api/configuracoes/(?<nxtPempresaId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/empresas/[id]",
      "regex": "^/api/empresas/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
