      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/lancamentos/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/produtos/[id]",
      "regex": "^/api/produtos/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/produtos/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/socios/[empresaId]",
      "regex": "^/api/socios/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPempresaId": "nxtPempresaId"
      },
